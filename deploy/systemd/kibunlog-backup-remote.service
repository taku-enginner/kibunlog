[Unit]
Description=kibunlog weekly remote backup sync (rclone -> R2)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/tak/kibunlog
EnvironmentFile=-/home/tak/kibunlog/.env
ExecStart=/home/tak/kibunlog/deploy/scripts/backup-remote.sh
User=tak

[Install]
WantedBy=multi-user.target
